{{#js}}
require(['local_xpstore/config_page', 'core/notification'], function(mod, notification) {
    mod.init();

    // Auto-select default card icon when product Type changes (if user hasn't manually picked one)
    var typeSelect = document.getElementById('type_select');
    var productIconInput = document.getElementById('product_icon_input');
    if (typeSelect && productIconInput) {
        var defaultTypeIcons = {
            'Q': 'bolt',
            'A': 'file-text',
            'F': 'comments',
            'G': 'star',
            'S': 'unlock',
            'U': 'unlock'
        };
        typeSelect.addEventListener('change', function() {
            if (productIconInput.getAttribute('data-user-selected') !== '1') {
                var defIcon = defaultTypeIcons[typeSelect.value] || 'gift';
                var optBtn = document.querySelector('.form-icon-option-btn[data-icon="' + defIcon + '"]');
                var defLabel = optBtn ? optBtn.getAttribute('data-label') : defIcon;
                productIconInput.value = defIcon;
                var imgPrev = document.getElementById('form_card_img_preview');
                if (imgPrev) {
                    imgPrev.style.display = 'none';
                }
                var prev = document.getElementById('form_card_icon_preview');
                if (prev) {
                    prev.style.display = '';
                    prev.className = 'fa fa-' + defIcon + ' mr-2';
                }
                var lbl = document.getElementById('form_card_icon_label');
                if (lbl) {
                    lbl.textContent = defLabel;
                }
            }
        });
    }

    // Toggle hidebylevel dropdown when minlevel > 0
    var minlevelInput = document.getElementById('minlevel_input');
    var hidebylevelContainer = document.getElementById('hidebylevel_container');
    if (minlevelInput && hidebylevelContainer) {
        var toggleHideByLevel = function() {
            var val = parseInt(minlevelInput.value, 10) || 0;
            hidebylevelContainer.style.display = (val > 0) ? '' : 'none';
        };
        minlevelInput.addEventListener('input', toggleHideByLevel);
        minlevelInput.addEventListener('change', toggleHideByLevel);
    }

    // Custom image upload validation (max 256 KB) and live preview in Product Form
    var maxCardImgBytes = 256 * 1024;
    var productIconFile = document.getElementById('product_icon_file');
    if (productIconFile) {
        productIconFile.addEventListener('change', function() {
            var file = productIconFile.files && productIconFile.files[0];
            if (!file) {
                return;
            }
            if (file.size > maxCardImgBytes) {
                notification.addNotification({message: '{{str_errorimagesize}}', type: 'error'});
                productIconFile.value = '';
                return;
            }
            if (productIconInput) {
                productIconInput.setAttribute('data-user-selected', '1');
            }
            var reader = new FileReader();
            reader.onload = function(evt) {
                var icoPrev = document.getElementById('form_card_icon_preview');
                if (icoPrev) {
                    icoPrev.style.display = 'none';
                }
                var imgPrev = document.getElementById('form_card_img_preview');
                if (imgPrev) {
                    imgPrev.src = evt.target.result;
                    imgPrev.style.display = '';
                }
                var lbl = document.getElementById('form_card_icon_label');
                if (lbl) {
                    lbl.textContent = file.name;
                }
            };
            reader.readAsDataURL(file);
        });
    }

    // Custom image upload validation (max 256 KB) and live preview in Settings Tab
    document.querySelectorAll('.card-icon-file-input').forEach(function(fileInput) {
        fileInput.addEventListener('change', function() {
            var file = fileInput.files && fileInput.files[0];
            if (!file) {
                return;
            }
            if (file.size > maxCardImgBytes) {
                notification.addNotification({message: '{{str_errorimagesize}}', type: 'error'});
                fileInput.value = '';
                return;
            }
            var itemkey = fileInput.getAttribute('data-itemkey');
            var reader = new FileReader();
            reader.onload = function(evt) {
                var icoPrev = document.getElementById('preview_card_' + itemkey);
                if (icoPrev) {
                    icoPrev.style.display = 'none';
                }
                var imgPrev = document.getElementById('preview_card_img_' + itemkey);
                if (imgPrev) {
                    imgPrev.src = evt.target.result;
                    imgPrev.style.display = '';
                }
                var mcIcon = document.getElementById('preview_mockup_card_icon');
                if (mcIcon) {
                    mcIcon.style.display = 'none';
                }
                var mcImg = document.getElementById('preview_mockup_card_img');
                if (mcImg) {
                    mcImg.src = evt.target.result;
                    mcImg.style.display = '';
                }
                var mwIcon = document.getElementById('preview_mockup_widget_icon');
                if (mwIcon) {
                    mwIcon.style.display = 'none';
                }
                var mwImg = document.getElementById('preview_mockup_widget_img');
                if (mwImg) {
                    mwImg.src = evt.target.result;
                    mwImg.style.display = '';
                }
            };
            reader.readAsDataURL(file);
        });
    });

    // Predefined Palettes logic (placed here to avoid requiring Grunt AMD compilation)
    var paletteBtns = document.querySelectorAll('.palette-btn');
    var colorPrimary = document.querySelector('input[name="color_primary"]');
    var colorSecondary = document.querySelector('input[name="color_secondary"]');
    var colorIcon = document.querySelector('input[name="color_icon"]');
    var colorCatIcon = document.querySelector('input[name="color_cat_icon"]');

    if (colorIcon) {
        var syncCardIconColor = function(e) {
            document.querySelectorAll('.card-icon-preview').forEach(function(el) {
                el.style.color = e.target.value;
            });
        };
        colorIcon.addEventListener('input', syncCardIconColor);
        colorIcon.addEventListener('change', syncCardIconColor);
    }

    if (colorCatIcon) {
        var syncCatIconColor = function(e) {
            document.querySelectorAll('.icon-preview').forEach(function(el) {
                el.style.color = e.target.value;
            });
        };
        colorCatIcon.addEventListener('input', syncCatIconColor);
        colorCatIcon.addEventListener('change', syncCatIconColor);
    }

    paletteBtns.forEach(function(btn) {
        btn.addEventListener('click', function() {
            if (colorPrimary) {
                colorPrimary.value = this.getAttribute('data-primary');
                colorPrimary.dispatchEvent(new Event('change'));
            }
            if (colorSecondary) {
                colorSecondary.value = this.getAttribute('data-secondary');
                colorSecondary.dispatchEvent(new Event('change'));
            }
            if (colorIcon) {
                colorIcon.value = this.getAttribute('data-icon');
                colorIcon.dispatchEvent(new Event('change'));
            }
            if (colorCatIcon) {
                colorCatIcon.value = this.getAttribute('data-caticon');
                colorCatIcon.dispatchEvent(new Event('change'));
            }
        });
    });
});
{{/js}}
