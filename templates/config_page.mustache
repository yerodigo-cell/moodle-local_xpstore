                <div style="width: 220px; min-width: 220px; flex-shrink: 0;">
                    <p class="small text-muted mb-3 font-weight-bold text-uppercase" style="letter-spacing: 0.5px;"><i class="fa fa-puzzle-piece"></i> {{#str}} mockup_widget, local_xpstore {{/str}}</p>
