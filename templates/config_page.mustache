{{!
    @template local_xpstore/config_page

    Example context (json):
    {
        "url": "https://moodle.org",
        "actionurl": "https://moodle.org",
        "cpstore": "#0056D2",
        "cbstore": "#00C9A7",
        "cistore": "#ff9800",
        "ccstore": "#ffffff",
        "cpactual": "#0056D2",
        "cbactual": "#00C9A7",
        "ciactual": "#ff9800",
        "ccactual": "#ffffff",
        "showbackbutton": true,
        "isteacher": false,
        "saldo": 100,
        "str_configtitle": "Configuration",
        "storecategories": [],
        "str_choosetype": "Choose type",
        "str_chooseactivity": "Choose activity",
        "str_widget_panel_title": "Widgets",
        "str_widget_panel_desc": "Desc",
        "str_colorconfig": "Color",
        "str_primarycolor": "Primary",
        "str_secondarycolor": "Secondary",
        "str_iconcolor": "Icon",
        "str_color_cat_icon": "Cat",
        "str_resetcolors": "Reset",
        "str_savecolors": "Save",
        "str_confirmresetcolors": "Confirm",
        "type_options": [{"value": "1", "label": "dummy"}],
        "activity_options": [{"id": 1, "name": "dummy"}],
        "category_icon_options": [{"catname": "d", "cathash": "h", "currenticon": "star", "icons": [{"value": "star", "label": "Star"}]}],
        "category_iframe_options": [{"iframecat": "a", "currenticon": "star", "catname": "Cat"}]
    }
}}
<div class="local_xpstore-container local_xpstore-config-wrapper config-wrapper">
    {{> local_xpstore/navigation_tabs }}


    {{#tab_products}}

            <div class="form-box {{#isediting}}editing{{/isediting}}">
        <h5 class="mb-3 font-weight-bold d-flex align-items-center">
            {{#isediting}}
                <i class="fa fa-pencil mr-2 text-success"></i> {{str_edit}}
            {{/isediting}}
            {{^isediting}}
                {{str_addproduct}}
            {{/isediting}}
        </h5>
        
        <form method="POST" action="{{url}}" enctype="multipart/form-data" class="row align-items-end">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <input type="hidden" name="action" value="{{#isediting}}edit_save{{/isediting}}{{^isediting}}add{{/isediting}}">
            {{#isediting}}
                <input type="hidden" name="old_item" value="{{olditemval}}">
            {{/isediting}}
            
            <div class="col-12 col-md-6 mb-3">
                <label class="small font-weight-bold mb-1 form-label-flex">
                    {{str_type}}
                    {{{help_type}}}
                </label>
                <div class="dropdown custom-select-dropdown w-100" style="position: relative;">
                    <button class="form-control form-control-sm text-left d-flex justify-content-between align-items-center bg-white" type="button" id="typeDropdownMenuButton" data-toggle="dropdown" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false" style="border: 1px solid #ced4da; box-shadow: none;">
                        <span id="selected-type-text">
                            {{#type_options}}
                                {{#selected}}<span class="badge-tipo bg-{{valuelower}}">{{label}}</span>{{/selected}}
                            {{/type_options}}
                            {{^etipo}}<span class="text-muted">{{str_choosetype}}</span>{{/etipo}}
                        </span>
                        <i class="fa fa-caret-down text-muted"></i>
                    </button>
                    <div class="dropdown-menu w-100 p-1 shadow-sm" aria-labelledby="typeDropdownMenuButton">
                        {{#type_options}}
                            <a class="dropdown-item py-2" href="#" onclick="document.getElementById('type_select').value='{{value}}'; document.getElementById('selected-type-text').innerHTML='<span class=\'badge-tipo bg-{{valuelower}}\'>{{label}}</span>'; document.getElementById('type_select').dispatchEvent(new Event('change')); return false;">
                                <span class="badge-tipo bg-{{valuelower}}">{{label}}</span>
                            </a>
                        {{/type_options}}
                    </div>
                    <select name="tipo" id="type_select" required style="opacity:0; position:absolute; z-index:-1; width:0; height:0; top: 50%; left: 50%; pointer-events:none;">
                    <option value="" disabled {{^etipo}}selected{{/etipo}}>{{str_choosetype}}</option>
                    {{#type_options}}
                        <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                    {{/type_options}}
                </select>
                </div>
            </div>

            <div class="col-12 col-md-6 mb-3">
                <label class="small font-weight-bold mb-1 form-label-block">
                    {{str_activity}}
                </label>
                <div class="dropdown custom-select-dropdown w-100" style="position: relative;">
                    <button class="form-control form-control-sm text-left d-flex justify-content-between align-items-center bg-white" type="button" id="activityDropdownMenuButton" data-toggle="dropdown" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false" style="border: 1px solid #ced4da; box-shadow: none;">
                        <span id="selected-activity-text" class="text-truncate" style="max-width: 90%;">
                            {{#activity_options}}
                                {{#selected}}{{{name}}}{{/selected}}
                            {{/activity_options}}
                            {{^ecmid}}<span class="text-muted">{{str_chooseactivity}}</span>{{/ecmid}}
                        </span>
                        <i class="fa fa-caret-down text-muted"></i>
                    </button>
                    <div class="dropdown-menu w-100 p-1 shadow-sm" aria-labelledby="activityDropdownMenuButton" id="activity_dropdown_menu" style="max-height: 300px; overflow-y: auto;">
                        {{#activity_options}}
                            <a class="dropdown-item py-2 text-truncate" href="#" onclick="document.getElementById('activity_select').value='{{id}}'; document.getElementById('selected-activity-text').innerHTML=this.innerHTML; document.getElementById('activity_select').dispatchEvent(new Event('change')); return false;">
                                {{{name}}}
                            </a>
                        {{/activity_options}}
                    </div>
                    <select name="cmid" id="activity_select" class="form-control form-control-sm" required style="opacity:0; position:absolute; z-index:-1; width:0; height:0; top: 50%; left: 50%; pointer-events:none;">
                        <option value="" disabled {{^ecmid}}selected{{/ecmid}}>{{str_chooseactivity}}</option>
                        {{#activity_options}}
                            <option value="{{id}}" data-modname="{{modname}}" data-html="{{name}}" {{#selected}}selected{{/selected}}>{{{name}}}</option>
                        {{/activity_options}}
                    </select>
                </div>
            </div>

            <div class="col-12 col-md-6 mb-3">
                <label class="small font-weight-bold mb-1 form-label-block">{{str_cost}}</label>
                <input type="number" name="costo" class="form-control form-control-sm bg-white" required value="{{ecosto}}" style="border: 1px solid #ced4da; box-shadow: none;">
            </div>

            <div class="col-12 col-md-6 mb-3">
                <label class="small font-weight-bold mb-1 form-label-block">{{str_limit}}</label>
                <input type="number" name="limite" min="0" class="form-control form-control-sm bg-white" placeholder="{{str_limitzero}}" value="{{elimite}}" style="border: 1px solid #ced4da; box-shadow: none;">
            </div>



            <div class="col-12 col-md-6 mb-3">
                <label class="small font-weight-bold mb-1 form-label-category">{{str_category}}</label>
                <input type="text" name="categoria" class="form-control form-control-sm bg-white" value="{{ecat}}" style="border: 1px solid #ced4da; box-shadow: none;">
            </div>

            <div class="col-12 col-md-6 mb-3">
                <label class="small font-weight-bold mb-1 form-label-flex">
                    {{str_label}}
                    {{{help_label}}}
                </label>
                <input type="text" name="nombre" class="form-control form-control-sm bg-white" value="{{enombre}}" style="border: 1px solid #ced4da; box-shadow: none;">
            </div>

            <div class="col-12 col-md-6 mb-3">
                <label class="small font-weight-bold mb-1 form-label-block">{{str_cardicon}}</label>
                <div class="dropdown custom-select-dropdown w-100" style="position: relative;">
                    <button class="form-control form-control-sm text-left d-flex justify-content-between align-items-center bg-white" type="button" id="cardIconDropdownMenuButton" data-toggle="dropdown" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false" style="border: 1px solid #ced4da; box-shadow: none;">
                        <span id="selected-card-icon-text" class="d-flex align-items-center text-truncate" style="max-width: 90%;">
                            <img src="{{eiconourl}}" id="form_card_img_preview" class="mr-2" alt="" style="width: 22px; height: 22px; object-fit: contain; {{^eis_custom_image}}display: none;{{/eis_custom_image}}">
                            <i class="fa fa-{{eicono}} mr-2" id="form_card_icon_preview" style="color: {{ciactual}}; font-size: 16px; width: 20px; text-align: center; {{#eis_custom_image}}display: none;{{/eis_custom_image}}"></i>
                            <span id="form_card_icon_label">{{eiconolabel}}</span>
                        </span>
                        <i class="fa fa-caret-down text-muted"></i>
                    </button>
                    <div class="dropdown-menu p-2 shadow-sm" aria-labelledby="cardIconDropdownMenuButton" style="min-width: 230px; z-index: 1050;">
                        <div class="d-flex flex-wrap" style="gap: 6px;">
                        {{#form_icon_options}}
                            <button type="button" class="btn btn-light border form-icon-option-btn" data-icon="{{value}}" data-label="{{label}}" onclick="var inp = document.getElementById('product_icon_input'); inp.value = '{{value}}'; inp.setAttribute('data-user-selected', '1'); var finp = document.getElementById('product_icon_file'); if (finp) finp.value = ''; var imgPrev = document.getElementById('form_card_img_preview'); if (imgPrev) imgPrev.style.display = 'none'; var icoPrev = document.getElementById('form_card_icon_preview'); if (icoPrev) { icoPrev.style.display = ''; icoPrev.className = 'fa fa-{{value}} mr-2'; } document.getElementById('form_card_icon_label').textContent = '{{label}}';" style="width: 34px; height: 34px; display: flex; align-items: center; justify-content: center; padding: 0;" title="{{label}}">
                                <i class="fa fa-{{value}}" style="color: {{ciactual}};"></i>
                            </button>
                        {{/form_icon_options}}
                        </div>
                        <div class="mt-2 pt-2 border-top">
                            <label for="product_icon_file" class="btn btn-sm btn-outline-primary w-100 mb-0 d-flex align-items-center justify-content-center" style="gap: 6px; cursor: pointer; font-weight: 600; font-size: 12px;" onclick="event.stopPropagation();">
                                <i class="fa fa-upload"></i> {{str_uploadimage}}
                            </label>
                            <div class="text-muted text-center mt-1" style="font-size: 10px;">{{str_maximagesize}}</div>
                        </div>
                    </div>
                    <input type="hidden" name="icono" id="product_icon_input" value="{{eicono}}" data-user-selected="{{#isediting}}1{{/isediting}}{{^isediting}}0{{/isediting}}">
                    <input type="file" name="icono_file" id="product_icon_file" accept="image/png,image/jpeg,image/webp,image/gif" style="display: none;">
                </div>
            </div>

            <div id="bonus_container" class="col-12 col-md-6 mb-3" style="display: none;">
                <label class="small font-weight-bold mb-1 form-label-block">{{str_gradepoints}}</label>
                <input type="number" step="0.1" name="valor_nota" class="form-control form-control-sm bg-white" value="{{evalor}}" style="border: 1px solid #ced4da; box-shadow: none;">
            </div>

            <div class="col-12 col-md-6 mb-3">
                <label class="small font-weight-bold mb-1 form-label-flex">
                    {{str_requirement}}
                    {{{help_requirement}}}
                </label>
                <div class="dropdown custom-select-dropdown w-100" style="position: relative;">
                    <button class="form-control form-control-sm text-left d-flex justify-content-between align-items-center bg-white" type="button" id="requisitoDropdownMenuButton" data-toggle="dropdown" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false" style="border: 1px solid #ced4da; box-shadow: none;">
                        <span id="selected-requisito-text" class="text-truncate" style="max-width: 90%;">
                            {{#requirement_options}}
                                {{#selected}}{{{name}}}{{/selected}}
                            {{/requirement_options}}
                        </span>
                        <i class="fa fa-caret-down text-muted"></i>
                    </button>
                    <div class="dropdown-menu w-100 p-1 shadow-sm" aria-labelledby="requisitoDropdownMenuButton" style="max-height: 300px; overflow-y: auto;">
                        {{#requirement_options}}
                            <a class="dropdown-item py-2 text-truncate" href="#" onclick="document.getElementById('requisito_select').value='{{id}}'; document.getElementById('selected-requisito-text').innerHTML=this.innerHTML; document.getElementById('requisito_select').dispatchEvent(new Event('change')); return false;">
                                {{{name}}}
                            </a>
                        {{/requirement_options}}
                    </div>
                    <select name="requisito" id="requisito_select" class="form-control form-control-sm" style="opacity:0; position:absolute; z-index:-1; width:0; height:0; top: 50%; left: 50%; pointer-events:none;">
                        {{#requirement_options}}
                            <option value="{{id}}" {{#selected}}selected{{/selected}}>{{{name}}}</option>
                        {{/requirement_options}}
                    </select>
                </div>
            </div>

            <div id="hiddenwhenlocked_container" class="col-12 col-md-6 mb-3" style="display: none;">
                <label class="small font-weight-bold mb-1 form-label-flex">
                    {{str_hideactivity}}
                    {{{help_hiddenwhenlocked}}}
                </label>
                <div class="dropdown custom-select-dropdown w-100" style="position: relative;">
                    <button class="form-control form-control-sm text-left d-flex justify-content-between align-items-center bg-white" type="button" id="hwlDropdownMenuButton" data-toggle="dropdown" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false" style="border: 1px solid #ced4da; box-shadow: none;">
                        <span id="selected-hwl-text" class="text-truncate" style="max-width: 90%;">
                            {{#ehiddenwhenlocked}}<i class="fa fa-eye-slash mr-2"></i> <span>{{str_hidecompletely}}</span>{{/ehiddenwhenlocked}}
                            {{^ehiddenwhenlocked}}<i class="fa fa-eye mr-2"></i> <span>{{str_showrestricted}}</span>{{/ehiddenwhenlocked}}
                        </span>
                        <i class="fa fa-caret-down text-muted"></i>
                    </button>
                    <div class="dropdown-menu w-100 p-1 shadow-sm" aria-labelledby="hwlDropdownMenuButton">
                        <a class="dropdown-item py-2 text-truncate" href="#" onclick="document.querySelector('select[name=\'hiddenwhenlocked\']').value='0'; document.getElementById('selected-hwl-text').innerHTML=this.innerHTML; document.querySelector('select[name=\'hiddenwhenlocked\']').dispatchEvent(new Event('change')); return false;">
                            <i class="fa fa-eye mr-2"></i> <span>{{str_showrestricted}}</span>
                        </a>
                        <a class="dropdown-item py-2 text-truncate" href="#" onclick="document.querySelector('select[name=\'hiddenwhenlocked\']').value='1'; document.getElementById('selected-hwl-text').innerHTML=this.innerHTML; document.querySelector('select[name=\'hiddenwhenlocked\']').dispatchEvent(new Event('change')); return false;">
                            <i class="fa fa-eye-slash mr-2"></i> <span>{{str_hidecompletely}}</span>
                        </a>
                    </div>
                    <select name="hiddenwhenlocked" class="form-control form-control-sm" style="opacity:0; position:absolute; z-index:-1; width:0; height:0; top: 50%; left: 50%; pointer-events:none;">
                        <option value="0" {{^ehiddenwhenlocked}}selected{{/ehiddenwhenlocked}}>{{str_showrestricted}}</option>
                        <option value="1" {{#ehiddenwhenlocked}}selected{{/ehiddenwhenlocked}}>{{str_hidecompletely}}</option>
                    </select>
                </div>
            </div>

            <div class="col-12 col-md-6 mb-3">
                <label class="small font-weight-bold mb-1 form-label-flex">
                    {{str_minlevel}}
                    {{{help_minlevel}}}
                </label>
                <input type="number" name="minlevel" id="minlevel_input" min="0" class="form-control form-control-sm bg-white" placeholder="{{str_minlevelzero}}" value="{{eminlevel}}" style="border: 1px solid #ced4da; box-shadow: none;">
            </div>

            <div id="hidebylevel_container" class="col-12 col-md-6 mb-3" style="{{^has_eminlevel}}display: none;{{/has_eminlevel}}">
                <label class="small font-weight-bold mb-1 form-label-block">{{str_levelvisibility}}</label>
                <div class="dropdown custom-select-dropdown w-100" style="position: relative;">
                    <button class="form-control form-control-sm text-left d-flex justify-content-between align-items-center bg-white" type="button" id="hblDropdownMenuButton" data-toggle="dropdown" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false" style="border: 1px solid #ced4da; box-shadow: none;">
                        <span id="selected-hbl-text" class="text-truncate" style="max-width: 90%;">
                            {{#ehidebylevel}}<i class="fa fa-eye-slash mr-2"></i> <span>{{str_hidecardbylevel}}</span>{{/ehidebylevel}}
                            {{^ehidebylevel}}<i class="fa fa-lock mr-2"></i> <span>{{str_showlockedbylevel}}</span>{{/ehidebylevel}}
                        </span>
                        <i class="fa fa-caret-down text-muted"></i>
                    </button>
                    <div class="dropdown-menu w-100 p-1 shadow-sm" aria-labelledby="hblDropdownMenuButton">
                        <a class="dropdown-item py-2 text-truncate" href="#" onclick="document.querySelector('select[name=\'hidebylevel\']').value='1'; document.getElementById('selected-hbl-text').innerHTML=this.innerHTML; return false;">
                            <i class="fa fa-eye-slash mr-2"></i> <span>{{str_hidecardbylevel}}</span>
                        </a>
                        <a class="dropdown-item py-2 text-truncate" href="#" onclick="document.querySelector('select[name=\'hidebylevel\']').value='0'; document.getElementById('selected-hbl-text').innerHTML=this.innerHTML; return false;">
                            <i class="fa fa-lock mr-2"></i> <span>{{str_showlockedbylevel}}</span>
                        </a>
                    </div>
                    <select name="hidebylevel" class="form-control form-control-sm" style="opacity:0; position:absolute; z-index:-1; width:0; height:0; top: 50%; left: 50%; pointer-events:none;">
                        <option value="1" {{#ehidebylevel}}selected{{/ehidebylevel}}>{{str_hidecardbylevel}}</option>
                        <option value="0" {{^ehidebylevel}}selected{{/ehidebylevel}}>{{str_showlockedbylevel}}</option>
                    </select>
                </div>
            </div>

            <div class="col-12 d-flex mt-2" style="justify-content: flex-end;">
                {{#isediting}}
                    <a href="{{url}}" class="btn btn-secondary px-4 py-2 mr-2 btn-config-cancel">{{str_cancel}}</a>
                    <button type="submit" class="btn-ucm-edit px-4 py-2">{{str_update}}</button>
                {{/isediting}}
                {{^isediting}}
                    <button type="submit" class="btn-ucm-add px-4 py-2">{{str_add}}</button>
                {{/isediting}}
            </div>
        </form>
    </div>

    <div class="form-box mb-4">
        <div class="d-flex justify-content-between align-items-end mb-3 catalog-header-mobile">
        <h5 class="m-0 font-weight-bold">
            {{str_currentcatalog}}
        </h5>
        {{#has_items}}
            <div class="d-flex gap-2 align-items-center">
                <button type="button" class="btn btn-sm btn-outline-danger mr-2" id="btn-delete-selected" style="display: none;" data-xpstore-title="{{str_delete}}" data-xpstore-confirm="{{str_confirmdelete}}" onclick="event.preventDefault(); var el = this; require(['core/notification', 'core/str'], function(Notification, Str) { Str.get_strings([{key: 'confirm', component: 'core'}, {key: 'yes', component: 'core'}, {key: 'cancel', component: 'core'}]).then(function(s) { Notification.confirm(el.getAttribute('data-xpstore-title') || s[0], el.getAttribute('data-xpstore-confirm'), s[1], s[2], function() { document.getElementById('bulk-delete-form').submit(); }); }); }); return false;">
                    <i class="fa fa-trash"></i> {{str_delete}}
                </button>
            </div>
        {{/has_items}}
    </div>

    <form method="POST" action="{{url}}" id="bulk-delete-form">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <input type="hidden" name="action" value="bulkdelete">
    <div class="table-responsive-wrapper mb-4">
        <table class="table-products">
            <thead>
                <tr class="table-products-row">
                    <th style="width: 30px;"></th>
                    <th class="small px-3" style="width: 40px; text-align: center;">
                        <input type="checkbox" id="select-all-products" style="cursor: pointer;">
                    </th>
                    <th class="small px-3">{{str_coltype}}</th>
                    <th class="small">{{str_colcategory}}</th>
                    <th class="small">{{str_colactivity}}</th>
                    <th class="small text-center">{{str_colcost}}</th>
                    <th class="small text-center">{{str_limit}}</th>
                    <th class="small">{{str_collabel}}</th>
                    <th class="small text-right px-3">{{str_colaction}}</th>
                </tr>
            </thead>
            <tbody>
                {{^has_items}}
                    <tr><td colspan='9' class='text-center text-muted py-4'>{{str_norewardscreated}}</td></tr>
                {{/has_items}}
                {{#catalog_items}}
                    <tr data-rawitem="{{rawitem}}" class="sortable-row">
                        <td class="text-center text-muted" style="cursor: grab;">
                            <i class="fa fa-bars drag-handle"></i>
                        </td>
                        <td class="px-3 text-center">
                            <input type="checkbox" name="bulkdeleteitems[]" value="{{rawitem}}" class="product-checkbox" style="cursor: pointer;">
                        </td>
                        <td class="px-3">
                            <span class="badge-tipo bg-{{tipolower}}">
                                {{#is_unlock}}
                                    {{#hiddenwhenlocked}}
                                        <i class="fa fa-eye-slash mr-1"></i>
                                    {{/hiddenwhenlocked}}
                                    {{^hiddenwhenlocked}}
                                        <i class="fa fa-eye mr-1"></i>
                                    {{/hiddenwhenlocked}}
                                {{/is_unlock}}
                                {{labeltipo}}
                            </span>
                            {{#has_req}}
                                <div class="mt-1 small font-weight-bold" style="color: #d32f2f; font-size: 11px; white-space: nowrap;">
                                    <i class="fa fa-lock mr-1"></i> {{str_requires_short}}: {{req_name}}
                                </div>
                            {{/has_req}}
                            {{#has_minlevel}}
                                <div class="mt-1 small font-weight-bold" style="color: #6a1b9a; font-size: 11px; white-space: nowrap;">
                                    {{#hidebylevel}}<i class="fa fa-eye-slash mr-1"></i>{{/hidebylevel}}
                                    {{^hidebylevel}}<i class="fa fa-lock mr-1"></i>{{/hidebylevel}}
                                    {{str_minlevel_short}}: {{minlevel}}
                                </div>
                            {{/has_minlevel}}
                        </td>
                        <td>
                            <span class="badge-category">
                                {{cat}}
                            </span>
                        </td>
                        <td class="small">{{{realnamehtml}}}</td>
                        <td class="text-center font-weight-bold" style="color: #0056D2;">{{cost}} XP</td>
                        <td class="text-center font-weight-bold td-limit">
                            {{#has_item_limit}}
                                {{limiteactual}}
                            {{/has_item_limit}}
                            {{^has_item_limit}}
                                <span class="td-limit-inf">∞</span>
                            {{/has_item_limit}}
                        </td>
                        <td>
                            {{#is_custom_image}}
                                <img src="{{icon_url}}" alt="" class="mr-1" style="width: 22px; height: 22px; object-fit: contain; vertical-align: middle;">
                            {{/is_custom_image}}
                            {{^is_custom_image}}
                                <i class="fa fa-{{icon}} mr-1" style="color: {{ciactual}}; width: 18px; text-align: center;"></i>
                            {{/is_custom_image}}
                            <strong>{{displayname}}</strong> 
                            {{#is_grade_boost}} (+{{val}}) {{/is_grade_boost}}
                        </td>
                        <td class="text-right px-3" style="min-width: 110px;">
                            <button type="button" class="btn btn-sm btn-info text-white mr-1" title="{{str_copysinglecard}}" data-action="copy-widget" data-code="{{iframecode}}">
                                <i class="fa fa-code"></i>
                            </button>
                            <a href="{{editurl}}" class="btn btn-sm btn-outline-secondary mr-1 btn-outline-edit" title="{{str_edit}}">
                                {{str_edit}}
                            </a>
                            <a href="{{deleteurl}}" class="btn btn-sm text-danger" title="{{str_delete}}" data-xpstore-title="{{str_delete}}" data-xpstore-confirm="{{str_confirmdelete}}" onclick="event.preventDefault(); var el = this; require(['core/notification', 'core/str'], function(Notification, Str) { Str.get_strings([{key: 'confirm', component: 'core'}, {key: 'yes', component: 'core'}, {key: 'cancel', component: 'core'}]).then(function(s) { Notification.confirm(el.getAttribute('data-xpstore-title') || s[0], el.getAttribute('data-xpstore-confirm'), s[1], s[2], function() { window.location.href = el.href; }); }); }); return false;">
